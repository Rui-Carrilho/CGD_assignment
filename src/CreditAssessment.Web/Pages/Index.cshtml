@page
@model CreditAssessment.Web.Pages.IndexModel

@{
    ViewData["Title"] = "Novo pedido";
}

<div class="page-heading">
    <p class="eyebrow">01 / Avaliação</p>
    <h1>Novo pedido de crédito</h1>
    <p class="lead">
        Introduza os dados do pedido. A aplicação valida-os, calcula os
        indicadores e apresenta a decisão com os respetivos motivos.
    </p>
</div>

<section class="sample-section" aria-labelledby="sample-heading">
    <details class="example-picker">
        <summary>
            <span>
                <strong>Preencher com um caso de exemplo</strong>
                <small>15 casos de decisão, validação e limites</small>
            </span>
        </summary>

        <div class="example-picker-content">
            <h2>Casos de decisão</h2>

            <div class="example-links">
                <a asp-page="/Index" asp-route-scenario="A">
                    <strong>Aprovação</strong>
                    <span>Pedido sem condições restritivas</span>
                </a>

                <a asp-page="/Index" asp-route-scenario="B">
                    <strong>Contrato</strong>
                    <span>Contrato a prazo e esforço intermédio</span>
                </a>

                <a asp-page="/Index" asp-route-scenario="C">
                    <strong>Incidentes</strong>
                    <span>Existência de incidentes de crédito</span>
                </a>

                <a asp-page="/Index" asp-route-scenario="D">
                    <strong>Esforço</strong>
                    <span>Taxa de esforço elevada</span>
                </a>
            </div>

            <h2>Validação e perfil do cliente</h2>

            <div class="example-links">
                <a asp-page="/Index" asp-route-scenario="INCOMPLETE">
                    <strong>Incompleto</strong>
                    <span>Vários campos obrigatórios vazios</span>
                </a>

                <a asp-page="/Index" asp-route-scenario="ZERO_INCOME">
                    <strong>Sem rendimento</strong>
                    <span>Rendimento mensal igual a zero</span>
                </a>

                <a asp-page="/Index" asp-route-scenario="UNEMPLOYED">
                    <strong>Desemprego</strong>
                    <span>Cliente desempregado com rendimento válido</span>
                </a>
            </div>

            <h2>Fronteiras e prioridade das regras</h2>

            <div class="example-links">
                <a asp-page="/Index" asp-route-scenario="AGE_EXACT_75">
                    <strong>75 anos</strong>
                    <span>Idade final exatamente no limite</span>
                </a>

                <a asp-page="/Index" asp-route-scenario="AGE_LIMIT">
                    <strong>&gt;75 anos</strong>
                    <span>Idade final acima do limite</span>
                </a>

                <a asp-page="/Index" asp-route-scenario="EFFORT_35">
                    <strong>35%</strong>
                    <span>Taxa de esforço exatamente no limite</span>
                </a>

                <a asp-page="/Index" asp-route-scenario="EFFORT_50">
                    <strong>50%</strong>
                    <span>Taxa de esforço ainda sem recusa</span>
                </a>

                <a asp-page="/Index" asp-route-scenario="EFFORT_OVER_50">
                    <strong>&gt;50%</strong>
                    <span>Taxa de esforço que determina recusa</span>
                </a>

                <a asp-page="/Index" asp-route-scenario="AMOUNT_LIMIT">
                    <strong>Limite 20×</strong>
                    <span>Montante acima do limite recomendado</span>
                </a>

                <a asp-page="/Index" asp-route-scenario="HIGH_AMOUNT">
                    <strong>&gt;50 mil €</strong>
                    <span>Montante elevado</span>
                </a>

                <a asp-page="/Index" asp-route-scenario="MULTIPLE_RULES">
                    <strong>Prioridade</strong>
                    <span>Recusa e análise manual em simultâneo</span>
                </a>
            </div>

            <p class="field-note">
                Selecionar um caso apenas preenche o formulário.
                O pedido só é guardado depois de escolher “Avaliar pedido”.
            </p>
        </div>
    </details>
</section>

@if (Model.LoadedScenario is not null)
{
    <div class="notice" role="status">
        Exemplo carregado. Pode alterar qualquer valor antes de avaliar.
        <a asp-page="/Index">Limpar formulário</a>
    </div>
}

<div class="content-with-aside">
    <form method="post" asp-page="/Index" class="form-stack">
        <section class="panel">
            <div class="section-heading">
                <span class="step-number">1</span>
                <div>
                    <h2>Cliente</h2>
                    <p>Identificação e idade no momento do pedido.</p>
                </div>
            </div>

            <div class="field-grid">
                <div class="field">
                    <label asp-for="Nif">NIF</label>
                    <input asp-for="Nif" class="control"
                           inputmode="numeric" />
                    <small>Exatamente nove dígitos.</small>
                </div>

                <div class="field">
                    <label asp-for="Age">Idade</label>
                    <input asp-for="Age" class="control"
                           inputmode="numeric" />
                    <small>Em anos completos.</small>
                </div>
            </div>
        </section>

        <section class="panel">
            <div class="section-heading">
                <span class="step-number">2</span>
                <div>
                    <h2>Condições financeiras</h2>
                    <p>Valores mensais e características do crédito solicitado.</p>
                </div>
            </div>

            <div class="field-grid">
                <div class="field">
                    <label asp-for="MonthlyIncome">Rendimento mensal líquido</label>
                    <div class="input-with-unit">
                        <input asp-for="MonthlyIncome" class="control"
                               inputmode="decimal"/>
                        <span>€</span>
                    </div>
                    <small>Deve ser superior a zero.</small>
                </div>

                <div class="field">
                    <label asp-for="ExistingInstalments">Prestações atuais</label>
                    <div class="input-with-unit">
                        <input asp-for="ExistingInstalments" class="control"
                               inputmode="decimal"/>
                        <span>€</span>
                    </div>
                    <small>Total pago por mês; use 0 se não existirem.</small>
                </div>

                <div class="field">
                    <label asp-for="RequestedAmount">Valor pretendido</label>
                    <div class="input-with-unit">
                        <input asp-for="RequestedAmount" class="control"
                               inputmode="decimal"/>
                        <span>€</span>
                    </div>
                </div>

                <div class="field">
                    <label asp-for="TermMonths">Prazo</label>
                    <div class="input-with-unit">
                        <input asp-for="TermMonths" class="control"
                               inputmode="numeric"/>
                        <span>meses</span>
                    </div>
                </div>
            </div>

            <p class="field-note">
                Pode escrever valores decimais com ponto, por exemplo
                <code>2500.50</code>. Os valores serão apresentados com ponto.
            </p>
        </section>

        <section class="panel">
            <div class="section-heading">
                <span class="step-number">3</span>
                <div>
                    <h2>Risco e situação profissional</h2>
                    <p>Estas respostas podem exigir análise manual ou recusa.</p>
                </div>
            </div>

            <div class="field-grid">
                <div class="field">
                    <label asp-for="Employment">Situação profissional</label>
                    <select asp-for="Employment" class="control">
                        <option value="">Selecione uma opção</option>
                        <option value="Efetivo">Efetivo</option>
                        <option value="ContratoPrazo">Contrato a prazo</option>
                        <option value="Desempregado">Desempregado</option>
                    </select>
                </div>

                <div class="field">
                    <label asp-for="CreditIncidents">Incidentes de crédito</label>
                    <select asp-for="CreditIncidents" class="control">
                        <option value="">Selecione uma opção</option>
                        <option value="Não">Não</option>
                        <option value="Sim">Sim</option>
                    </select>
                </div>
            </div>
        </section>

        <div class="form-actions">
            <p>O pedido e o resultado serão guardados para consulta.</p>
            <button type="submit" class="button button-primary">
                Avaliar pedido <span aria-hidden="true">→</span>
            </button>
        </div>
    </form>

    <aside class="panel explainer">
        <p class="eyebrow">Como funciona</p>
        <h2>Uma decisão explicável</h2>
        <ol class="explain-list">
            <li>
                <strong>Validar</strong>
                <span>Dados que falham as condições iniciais tornam o pedido inválido.</span>
            </li>
            <li>
                <strong>Calcular</strong>
                <span>A prestação estimada e a taxa de esforço são calculadas para pedidos válidos.</span>
            </li>
            <li>
                <strong>Decidir</strong>
                <span>Quando várias regras se aplicam, prevalece a decisão mais restritiva.</span>
            </li>
        </ol>
        <div class="priority-note">
            <strong>Ordem de prioridade</strong>
            <span>Inválido → Recusado → Análise manual → Aprovado</span>
        </div>
    </aside>
</div>