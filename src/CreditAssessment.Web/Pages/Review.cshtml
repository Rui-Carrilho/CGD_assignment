@page "{id:guid}"
@model CreditAssessment.Web.Pages.ReviewModel
@using System.Globalization

@{
    ViewData["Title"] = "Revisão manual";
    var assessment = Model.Assessment!;
    var indicators = assessment.Evaluation.Indicators;
}

<div class="page-heading">
    <p class="eyebrow">Análise / Protótipo local</p>
    <h1>Rever pedido</h1>
    <p class="lead">
        Consulte os motivos antes de registar uma aprovação manual.
    </p>
</div>

<div class="result-grid">
    <section class="panel">
        <p class="eyebrow">Pedido @assessment.Id</p>
        <h2>Dados e motivos</h2>

        <dl class="detail-grid">
            <div>
                <dt>NIF</dt>
                <dd>@(assessment.Input.Nif ?? "—")</dd>
            </div>
            <div>
                <dt>Rendimento mensal</dt>
                <dd>@(assessment.Input.MonthlyIncome ?? "—") €</dd>
            </div>
            <div>
                <dt>Montante</dt>
                <dd>@(assessment.Input.RequestedAmount ?? "—") €</dd>
            </div>
            <div>
                <dt>Prazo</dt>
                <dd>@(assessment.Input.TermMonths ?? "—") meses</dd>
            </div>
        </dl>

        <ul class="reason-list">
        @foreach (var finding in assessment.Evaluation.Findings)
        {
            <li>
                <strong>@finding.Message</strong>
                <code>@finding.Code</code>
            </li>
        }
        </ul>

        @if (indicators is not null)
        {
            <p class="field-note">
                Prestação estimada:
                @(indicators.EstimatedInstalment.ToString("F2", CultureInfo.InvariantCulture)) € ·
                Taxa de esforço:
                @(indicators.EffortRate.ToString("F2", CultureInfo.InvariantCulture))%
            </p>
        }
    </section>

    <section class="panel">
        <p class="eyebrow">Decisão humana</p>
        <h2>Registar aprovação</h2>
        <p class="section-intro">
            O nome e a fundamentação ficarão no histórico do pedido.
        </p>

        <form method="post" asp-page="/Review"
              asp-route-id="@assessment.Id">
            <div asp-validation-summary="All"
                 class="validation-summary"></div>

            <div class="field">
                <label asp-for="Actor">Analista</label>
                <input asp-for="Actor" class="control"
                       maxlength="100" />
                <span asp-validation-for="Actor"
                      class="field-error"></span>
            </div>

            <div class="field review-field">
                <label asp-for="Justification">
                    Fundamentação da aprovação
                </label>
                <textarea asp-for="Justification"
                          class="control review-textarea"
                          maxlength="500"></textarea>
                <span asp-validation-for="Justification"
                      class="field-error"></span>
            </div>

            <div class="page-actions">
                <button type="submit" class="button button-primary">
                    Registar aprovação
                </button>
                <a asp-page="/Result"
                   asp-route-id="@assessment.Id"
                   class="button button-secondary">
                    Cancelar
                </a>
            </div>
        </form>
    </section>
</div>