@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnvironment

@{
    var title = ViewData["Title"] as string ?? "Pré-análise de crédito";

    var canUseAnalystArea = HostEnvironment.IsDevelopment()
        && ViewContext.HttpContext.Connection.RemoteIpAddress is { } remote
        && System.Net.IPAddress.IsLoopback(remote);
}

<!DOCTYPE html>
<html lang="pt-PT">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title · Pré-análise de crédito</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="shell header-inner">
            <a class="brand" asp-page="/Index">
                <span class="brand-mark" aria-hidden="true">C</span>
                <span>
                    <strong>Crédito</strong>
                    <small>Pré-análise</small>
                </span>
            </a>

            <nav aria-label="Navegação principal" class="site-nav">
                <a asp-page="/Index">Novo pedido</a>
                <a asp-page="/History">Pedidos</a>
                @if (canUseAnalystArea)
                {
                    <a asp-page="/ReviewQueue">Fila de análise</a>
                }
                <a asp-page="/Reports">Relatórios</a>
            </nav>
        </div>
    </header>

    <main class="shell page-content">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="shell">
            Protótipo de pré-análise. Uma decisão automática não substitui
            a decisão final da instituição.
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>